# ════════════════════════════════════════════════════════════
#  Research_Agent — Environment Variables
#  Copy this file to .env and fill in your keys
#  Location: HoloLearn-AI/Research_Agent/.env
# ════════════════════════════════════════════════════════════

# ── REQUIRED: Groq API key ───────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# ── REQUIRED: Tavily API key (web search) ────────────────────
# Get free key at: https://app.tavily.com
TAVILY_API_KEY=tvly-YOUR_KEY_HERE

# ── Model (provider auto-detected from name format) ──────────
# Groq models:       llama-3.3-70b-versatile   (default, free)
# OpenRouter models: meta-llama/llama-3.3-70b-instruct:free
# Google models:     gemini-2.0-flash
MODEL_FLASH=llama-3.3-70b-versatile

# ── Safety limits ────────────────────────────────────────────
MAX_TOOL_CALLS=50
MAX_ITERATIONS=12

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
